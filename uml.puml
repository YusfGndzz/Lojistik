@startuml
title Akıllı Lojistik Sistemi - UML Sınıf Diyagramı
skinparam classAttributeIconSize 0

package model {
  class Konum {
    - ad : String
    - x : double
    - y : double
    + mesafe(diger : Konum) : double
    + {static} depo() : Konum
  }
  enum Oncelik {
    NORMAL
    HIZLI
    ACIL
  }
  class Paket {
    - id : String
    - alici : String
    - agirlik : double
    - hedef : Konum
    - oncelik : Oncelik
  }
  abstract class Arac {
    - plaka : String
    - kapasite : double
    - yuk : List<Paket>
    + {abstract} getTur() : String
    + {abstract} kmBasinaMaliyet() : double
    + sabitMaliyet() : double
    + maliyetHesapla(km : double) : double
    + paketiAlabilirMi(p : Paket) : boolean
    + yukle(p : Paket) : boolean
    + bosalt()
    + kalanKapasite() : double
  }
  class Kamyon
  class Kamyonet
  class Motokurye {
    + paketiAlabilirMi(p : Paket) : boolean
  }
  class Rota {
    - arac : Arac
    - duraklar : List<Konum>
    + toplamMesafe() : double
    + maliyet() : double
  }
}

package strateji {
  interface DagitimStratejisi {
    + dagit(paketler, araclar) : List<Paket>
    + getAd() : String
  }
  class EnIyiYerlesimStratejisi
  class IlkUygunStratejisi
}

package rota {
  interface RotaOptimizer {
    + optimizeEt(baslangic, duraklar) : List<Konum>
  }
  class EnYakinKomsuOptimizer
}

package fabrika {
  class AracFabrikasi {
    + {static} olustur(tur, plaka, kapasite) : Arac
  }
}

package depo {
  interface "Repository<T>" as Repository {
    + hepsiniGetir() : List<T>
    + ekle(nesne : T)
    + sil(id : String) : boolean
  }
  abstract class "DosyaRepository<T>" as DosyaRepository
  class PaketRepository
  class AracRepository
}

package servis {
  class LojistikServisi {
    + planla() : DagitimPlani
    + setStrateji(s : DagitimStratejisi)
  }
  class DagitimPlani {
    + toplamMesafe() : double
    + toplamMaliyet() : double
  }
}

package arayuz {
  class KonsolMenu {
    + baslat()
  }
}

Arac <|-- Kamyon
Arac <|-- Kamyonet
Arac <|-- Motokurye
Paket --> Konum
Paket --> Oncelik
Arac o-- Paket
Rota --> Arac
Rota o-- Konum
DagitimStratejisi <|.. EnIyiYerlesimStratejisi
DagitimStratejisi <|.. IlkUygunStratejisi
RotaOptimizer <|.. EnYakinKomsuOptimizer
Repository <|.. DosyaRepository
DosyaRepository <|-- PaketRepository
DosyaRepository <|-- AracRepository
AracRepository ..> AracFabrikasi
AracFabrikasi ..> Arac : <<create>>
LojistikServisi --> Repository
LojistikServisi --> DagitimStratejisi
LojistikServisi --> RotaOptimizer
LojistikServisi ..> DagitimPlani
DagitimPlani o-- Rota
KonsolMenu --> LojistikServisi
@enduml